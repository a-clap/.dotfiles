#pragma once

#include <charconv>
#include <concepts>
#include <optional>
#include <string_view>
#include <system_error>
#include <type_traits>

namespace {{namespace}} {

template <typename T>
constexpr std::optional<T> parse(std::string_view) {
    static_assert(false, "type is not parseable");
}

template <std::integral T>
constexpr std::optional<T> parse(std::string_view src)
    requires(!std::is_same_v<T, bool>)
{
    auto const len = src.size();
    auto const* begin = src.data();
    int const base = [&]() {
        bool const starts_with_0 = len >= 1 and src[0] == '0';
        if (starts_with_0 and len >= 2) {
            if (src[1] == 'X' or src[1] == 'x') {
                begin = &src[2];
                return 16;
            }

            if (src[1] == 'B' or src[1] == 'b') {
                begin = &src[2];
                return 2;
            }

            begin = &src[1];
            return 8;
        }
        return 10;
    }();

    T out {};
    auto const* const end = src.data() + len;
    auto result = std::from_chars(begin, end, out, base);
    if (result.ec != std::errc() or result.ptr != end) {
        return std::nullopt;
    }
    return out;
}

template <std::floating_point T>
constexpr std::optional<T> parse(std::string_view src) {
    auto const len = src.size();
    auto const* begin = src.data();

    std::chars_format fmt = [&]() {
        if (len >= 2) {
            if (src[0] == '0' and (src[1] == 'x' or src[1] == 'X')) {
                begin = &src[2];
                return std::chars_format::hex;
            }
        }
        return std::chars_format::general;
    }();

    T out {};
    auto const* const end = src.data() + len;
    auto result = std::from_chars(begin, end, out, fmt);
    if (result.ec != std::errc() or result.ptr != end) {
        return std::nullopt;
    }

    return out;
}

template <>
constexpr std::optional<bool> parse(std::string_view src) {
    static constexpr auto kCmp = [](std::string_view lhs, std::string_view rhs) {
        return std::ranges::equal(lhs, rhs, [](char first_ch, char already_lower_ch) {
            return std::tolower(static_cast<unsigned char>(first_ch)) == already_lower_ch;
        });
    };

    static constexpr std::string_view kTrueValues[] = { "true", "on", "1" };
    for (auto const& value : kTrueValues) {
        if (kCmp(src, value)) {
            return true;
        }
    }
    static constexpr std::string_view kFalseValues[] = { "false", "off", "0" };
    for (auto const& value : kFalseValues) {
        if (kCmp(src, value)) {
            return false;
        }
    }
    return std::nullopt;
}

}  // namespace {{namespace}}
